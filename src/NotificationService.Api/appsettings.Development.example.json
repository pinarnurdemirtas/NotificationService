{
  "ConnectionStrings": {
    "NotificationDb": "Host=127.0.0.1;Port=5432;Database=notification_db;Username=notification_app;Password=YOUR_LOCAL_PASSWORD"
  },
  "Firebase": {
    "Enabled": false,
    "ProjectId": "YOUR_FIREBASE_PROJECT_ID",
    "CredentialsPath": "C:/path/to/firebase-service-account.json",
    "TimeoutSeconds": 30
  },
  "FirebaseWeb": {
    "ApiKey": "YOUR_APIKEY",
    "AuthDomain": "YOUR_AUTHDOMAIN",
    "ProjectId": "YOUR_PROJECTID",
    "StorageBucket": "YOUR_STORAGEBUCKET",
    "MessagingSenderId": "YOUR_MESSAGINGSENDERID",
    "AppId": "YOUR_APPID",
    "VapidPublicKey": "YOUR_VAPIDPUBLICKEY"
  },
  "Jwt": {
    "Issuer": "NotificationService",
    "Audience": "NotificationService.Web",
    "SigningKey": "REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_64_CHARACTERS",
    "LifetimeMinutes": 60
  }
}
